---
export interface Props {
  currentUsername?: string;
}

const { currentUsername = '' } = Astro.props;
---

<div
  id="add-device-modal"
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="add-device-modal-title"
  hidden
>
  <div class="modal-dialog">
    <div class="modal-header">
      <div>
        <h2 id="add-device-modal-title" class="modal-title">添加温室设备</h2>
        <p class="modal-subtitle">
          输入温室控制器编号并填写设备信息
        </p>
      </div>
      <button type="button" class="modal-close" data-close-add-device aria-label="关闭弹窗">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>

    <form id="add-device-form" novalidate>
      <div class="modal-body">
        <div id="add-device-error" class="alert alert-danger" role="alert" style="display: none; margin-bottom: 16px;">
          <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="m15 9-6 6" />
            <path d="m9 9 6 6" />
          </svg>
          <div>
            <strong id="add-device-error-title" style="display: block; margin-bottom: 2px;">无法绑定设备</strong>
            <span id="add-device-error-text"></span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="add-device-id">
            <span>设备编号 <span class="required-mark">*</span></span>
            <span class="form-hint mono">如：GH-0003</span>
          </label>
          <input
            id="add-device-id"
            name="deviceId"
            type="text"
            class="form-input mono"
            placeholder="例如：GH-0003"
            required
            autocomplete="off"
          />
          <div class="quick-chips">
            <button
              type="button"
              class="chip-btn"
              data-suggest-device="GH-0003"
              data-suggest-name="3号草莓实验棚"
              data-suggest-location="C区-试验田"
              data-suggest-crop="红颜草莓"
              data-suggest-notes="待接入温室设备"
            >
              GH-0003 · 3号草莓实验棚
            </button>
            <button
              type="button"
              class="chip-btn"
              data-suggest-device="GH-0000"
              data-suggest-notes="预留本地模拟测试设备"
            >
              GH-0000 · 本地模拟测试设备
            </button>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="add-device-name">设备名称</label>
          <input
            id="add-device-name"
            name="name"
            type="text"
            class="form-input"
            placeholder="例如：3号草莓实验棚"
            maxlength="60"
          />
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label" for="add-device-location">所属区域</label>
            <input
              id="add-device-location"
              name="location"
              type="text"
              class="form-input"
              placeholder="例如：C区-试验田"
              maxlength="60"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="add-device-crop">种植作物</label>
            <input
              id="add-device-crop"
              name="cropType"
              type="text"
              class="form-input"
              placeholder="例如：红颜草莓"
              maxlength="60"
            />
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 0;">
          <label class="form-label" for="add-device-notes">备注说明</label>
          <textarea
            id="add-device-notes"
            name="notes"
            class="form-textarea"
            placeholder="可填写温室养护说明、传感器位置或注意事项..."
            maxlength="300"
          ></textarea>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-add-device>取消</button>
        <button type="submit" id="add-device-submit-btn" class="btn btn-primary">
          确认绑定设备
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  (() => {
    const modal = document.getElementById('add-device-modal');
    const form = document.getElementById('add-device-form');
    const idInput = document.getElementById('add-device-id');
    const nameInput = document.getElementById('add-device-name');
    const locationInput = document.getElementById('add-device-location');
    const cropInput = document.getElementById('add-device-crop');
    const notesInput = document.getElementById('add-device-notes');
    const errorBox = document.getElementById('add-device-error');
    const errorTitle = document.getElementById('add-device-error-title');
    const errorText = document.getElementById('add-device-error-text');
    const submitBtn = document.getElementById('add-device-submit-btn');

    if (!modal || !form || !idInput || !errorBox || !errorTitle || !errorText || !submitBtn) return;

    function clearError() {
      errorBox.style.display = 'none';
      errorText.textContent = '';
      idInput.classList.remove('is-invalid');
      idInput.removeAttribute('aria-invalid');
    }

    function showError(title, msg) {
      errorTitle.textContent = title;
      errorText.textContent = msg;
      errorBox.style.display = 'flex';
      idInput.classList.add('is-invalid');
      idInput.setAttribute('aria-invalid', 'true');
      errorBox.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    function openModal() {
      clearError();
      modal.hidden = false;
      modal.classList.add('is-open');
      setTimeout(() => idInput.focus(), 40);
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.hidden = true;
      clearError();
    }

    window.openAddDeviceModal = openModal;
    window.closeAddDeviceModal = closeModal;

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      if (target.closest('[data-open-add-device]')) {
        openModal();
        return;
      }

      if (target.closest('[data-close-add-device]') || target === modal) {
        closeModal();
        return;
      }

      const suggestBtn = target.closest('[data-suggest-device]');
      if (suggestBtn) {
        clearError();
        const devId = suggestBtn.getAttribute('data-suggest-device') || '';
        idInput.value = devId;

        const sName = suggestBtn.getAttribute('data-suggest-name');
        const sLoc = suggestBtn.getAttribute('data-suggest-location');
        const sCrop = suggestBtn.getAttribute('data-suggest-crop');
        const sNotes = suggestBtn.getAttribute('data-suggest-notes');

        if (sName && nameInput && !nameInput.value.trim()) nameInput.value = sName;
        if (sLoc && locationInput && !locationInput.value.trim()) locationInput.value = sLoc;
        if (sCrop && cropInput && !cropInput.value.trim()) cropInput.value = sCrop;
        if (sNotes && notesInput && !notesInput.value.trim()) notesInput.value = sNotes;

        idInput.focus();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    idInput.addEventListener('input', () => {
      idInput.classList.remove('is-invalid');
      idInput.removeAttribute('aria-invalid');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const rawId = idInput.value.trim().toUpperCase();
      idInput.value = rawId;

      if (!rawId) {
        showError('请填写设备编号', '设备编号不能为空，请输入控制器编号（如 GH-0003）。');
        idInput.focus();
        return;
      }

      submitBtn.setAttribute('disabled', 'true');
      const prevLabel = submitBtn.textContent;
      submitBtn.textContent = '添加中...';

      try {
        const res = await fetch('/api/devices', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            deviceId: rawId,
            name: nameInput ? nameInput.value.trim() : '',
            location: locationInput ? locationInput.value.trim() : '',
            cropType: cropInput ? cropInput.value.trim() : '',
            notes: notesInput ? notesInput.value.trim() : '',
          }),
        });

        let payload = null;
        try {
          payload = await res.json();
        } catch {
          payload = null;
        }

        if (res.status === 201 || (res.ok && payload?.ok)) {
          if (typeof window.showToastNextLoad === 'function') {
            window.showToastNextLoad(`已成功添加设备 ${rawId}`, 'success');
          }
          closeModal();
          window.location.reload();
          return;
        }

        if (res.status === 409) {
          const conflictMsg =
            payload?.message || '该设备已被其他用户绑定，无法重复添加';
          showError('无法绑定设备', conflictMsg);
          idInput.focus();
          return;
        }

        const errMsg = payload?.message || `添加失败 (${res.status})，请检查设备编号格式`;
        showError('无法绑定设备', errMsg);
      } catch {
        showError('网络异常', '请求服务失败，请检查网络连接后重试');
      } finally {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = prevLabel || '确认绑定设备';
      }
    });
  })();
</script>
