---
import type { ScenarioType } from '../types/greenhouse';

interface Props {
  deviceId: string;
  online?: boolean;
}

const { deviceId, online = true } = Astro.props;

interface ScenarioOption {
  id: ScenarioType;
  tag: string;
  label: string;
  hint: string;
  kind: 'nominal' | 'fault' | 'neutral';
}

const SCENARIOS: ScenarioOption[] = [
  {
    id: 'normal',
    tag: '正常',
    label: '正常工况',
    hint: '温湿度与光照恢复至适宜范围',
    kind: 'nominal',
  },
  {
    id: 'hot',
    tag: '环境',
    label: '高温高湿',
    hint: '模拟高温闷湿，观察通风响应',
    kind: 'fault',
  },
  {
    id: 'dry',
    tag: '干旱',
    label: '土壤干旱',
    hint: '模拟土壤偏干，观察自动灌溉',
    kind: 'fault',
  },
  {
    id: 'water_lack',
    tag: '告警',
    label: '触发缺水告警',
    hint: '模拟缺水故障，暂停自动灌溉',
    kind: 'fault',
  },
  {
    id: 'turntable_failed',
    tag: '故障',
    label: '触发转盘故障',
    hint: '模拟转盘运行异常告警',
    kind: 'fault',
  },
  {
    id: 'water_restored',
    tag: '恢复',
    label: '水源恢复',
    hint: '恢复正常水位并重新供水',
    kind: 'nominal',
  },
  {
    id: 'offline',
    tag: '状态',
    label: '模拟离线',
    hint: '模拟设备暂时断开连接',
    kind: 'neutral',
  },
];
---

<section
  class="sim-console"
  data-simulator-bar
  data-device-id={deviceId}
  aria-label="工况模拟测试"
>
  <header class="sim-head">
    <div class="sim-head-main">
      <span class="sim-eyebrow">测试环境</span>
      <div class="sim-title-row">
        <h2 class="sim-title">工况模拟测试</h2>
        <span class={`sim-link-tag ${online ? 'is-online' : 'is-offline'}`}>
          <span class="sim-link-dot" aria-hidden="true"></span>
          {online ? '在线' : '离线'}
        </span>
      </div>
      <p class="sim-subtitle">
        为当前模拟设备注入典型环境或异常工况，实时查看环境趋势、告警联动与执行器状态变化。
      </p>
    </div>
  </header>

  <div class="sim-body">
    <div class="sim-grid" role="group" aria-label="模拟工况选择">
      {
        SCENARIOS.map((item) => (
          <button
            type="button"
            class={`sim-key sim-kind-${item.kind}`}
            data-sim-scenario={item.id}
            data-sim-label={item.label}
          >
            <span class="sim-key-top">
              <span class="sim-code">{item.tag}</span>
              <span class="sim-indicator" aria-hidden="true"></span>
            </span>
            <span class="sim-key-label">{item.label}</span>
            <span class="sim-key-hint">{item.hint}</span>
          </button>
        ))
      }
    </div>

    <div class="sim-feedback" data-sim-feedback hidden aria-live="polite"></div>
  </div>
</section>

<script>
  function notifyUser(message: string, type: 'success' | 'error' | 'info' | 'warning') {
    const w = window as unknown as {
      showToast?: (msg: string, variant?: string) => void;
    };
    if (typeof w.showToast === 'function') {
      w.showToast(message, type);
    }
  }

  function notifyNextLoad(message: string, type: 'success' | 'error' | 'info' | 'warning') {
    const w = window as unknown as {
      showToastNextLoad?: (msg: string, variant?: string) => void;
    };
    if (typeof w.showToastNextLoad === 'function') {
      w.showToastNextLoad(message, type);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-simulator-bar]').forEach((bar) => {
    const deviceId = bar.dataset.deviceId;
    if (!deviceId) return;

    const feedbackEl = bar.querySelector<HTMLElement>('[data-sim-feedback]');
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-sim-scenario]'));

    const setBusy = (busy: boolean, activeBtn?: HTMLButtonElement) => {
      buttons.forEach((btn) => {
        btn.disabled = busy;
        if (busy && btn === activeBtn) {
          btn.dataset.busy = 'true';
        } else {
          delete btn.dataset.busy;
        }
      });
    };

    const setFeedback = (text: string, state: 'loading' | 'ok' | 'err') => {
      if (!feedbackEl) return;
      feedbackEl.hidden = false;
      feedbackEl.dataset.state = state;
      feedbackEl.textContent = text;
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const scenario = btn.dataset.simScenario;
        const label = btn.dataset.simLabel || scenario || '模拟工况';
        if (!scenario) return;

        setBusy(true, btn);
        setFeedback(`正在执行「${label}」模拟...`, 'loading');

        try {
          const res = await fetch(`/api/devices/${encodeURIComponent(deviceId)}/simulate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ scenario }),
          });

          const payload = (await res.json().catch(() => null)) as {
            ok?: boolean;
            message?: string;
          } | null;

          if (!res.ok || !payload?.ok) {
            throw new Error(payload?.message || '工况模拟请求失败，请稍后重试');
          }

          const okMsg = payload.message || `已执行「${label}」，正在刷新最新状态...`;
          setFeedback(okMsg, 'ok');
          notifyUser(okMsg, 'success');
          notifyNextLoad(okMsg, 'success');

          window.setTimeout(() => {
            window.location.reload();
          }, 420);
        } catch (err) {
          const errMsg = err instanceof Error ? err.message : '模拟指令发送失败，请稍后重试';
          setFeedback(errMsg, 'err');
          notifyUser(errMsg, 'error');
          setBusy(false);
        }
      });
    });
  });
</script>

<style>
  .sim-console {
    background: var(--surface, #e7e0d3);
    border: 1px solid var(--line-strong, rgba(28, 32, 27, 0.28));
    border-radius: var(--r-lg, 8px);
    overflow: hidden;
  }

  .sim-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line, rgba(28, 32, 27, 0.14));
    background: var(--surface, #e7e0d3);
  }

  .sim-head-main {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .sim-eyebrow {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted, #5a5e56);
  }

  .sim-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .sim-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink, #1c201b);
    line-height: 1.3;
  }

  .sim-link-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.18rem 0.55rem;
    border-radius: var(--r-sm, 4px);
    border: 1px solid var(--line-strong, rgba(28, 32, 27, 0.28));
    background: var(--surface-elevated, #faf8f4);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink, #1c201b);
  }

  .sim-link-dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--muted, #5a5e56);
  }

  .sim-link-tag.is-online {
    border-color: var(--accent, #23533b);
    color: var(--accent, #23533b);
  }

  .sim-link-tag.is-online .sim-link-dot {
    background: var(--accent, #23533b);
  }

  .sim-link-tag.is-offline {
    color: var(--muted, #5a5e56);
  }

  .sim-subtitle {
    margin: 0.1rem 0 0;
    font-size: 0.875rem;
    color: var(--muted, #5a5e56);
    line-height: 1.5;
  }

  .sim-body {
    padding: 1rem 1.25rem 1.15rem;
    background: var(--surface-elevated, #faf8f4);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .sim-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    gap: 0.65rem;
  }

  .sim-key {
    appearance: none;
    min-height: 44px;
    padding: 0.7rem 0.85rem;
    border-radius: var(--r-md, 6px);
    border: 1px solid var(--line, rgba(28, 32, 27, 0.14));
    background: var(--bg, #f4f1ea);
    color: var(--ink, #1c201b);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      transform 140ms ease;
  }

  .sim-key:hover:not(:disabled) {
    background: var(--surface-elevated, #faf8f4);
    transform: translateY(-1px);
  }

  .sim-key:active:not(:disabled) {
    transform: translateY(0);
  }

  .sim-key:focus-visible {
    outline: 2px solid var(--accent, #23533b);
    outline-offset: 2px;
  }

  .sim-key:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .sim-key[data-busy='true'] {
    opacity: 1;
    border-color: var(--accent, #23533b);
    background: var(--surface, #e7e0d3);
  }

  .sim-key-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    width: 100%;
  }

  .sim-code {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted, #5a5e56);
    letter-spacing: 0.02em;
  }

  .sim-indicator {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--muted, #5a5e56);
    flex-shrink: 0;
  }

  .sim-kind-nominal .sim-indicator {
    background: var(--accent, #23533b);
  }

  .sim-kind-nominal:hover:not(:disabled) {
    border-color: var(--accent, #23533b);
  }

  .sim-kind-nominal:hover:not(:disabled) .sim-code {
    color: var(--accent, #23533b);
  }

  .sim-kind-fault .sim-indicator {
    background: var(--danger, #b42318);
  }

  .sim-kind-fault:hover:not(:disabled) {
    border-color: var(--danger, #b42318);
    background: var(--danger-surface, rgba(180, 35, 24, 0.08));
  }

  .sim-kind-fault:hover:not(:disabled) .sim-code {
    color: var(--danger, #b42318);
  }

  .sim-kind-neutral:hover:not(:disabled) {
    border-color: var(--line-strong, rgba(28, 32, 27, 0.28));
  }

  .sim-key-label {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink, #1c201b);
    line-height: 1.3;
  }

  .sim-key-hint {
    font-size: 0.8125rem;
    color: var(--muted, #5a5e56);
    line-height: 1.35;
  }

  .sim-feedback {
    padding: 0.65rem 0.9rem;
    border-radius: var(--r-sm, 4px);
    font-size: 0.875rem;
    line-height: 1.45;
    border: 1px solid var(--line-strong, rgba(28, 32, 27, 0.28));
    background: var(--inverse-bg, #181c18);
    color: #f4f1ea;
  }

  .sim-feedback[hidden] {
    display: none;
  }

  .sim-feedback[data-state='ok'] {
    border-color: var(--accent, #23533b);
    background: var(--accent, #23533b);
    color: var(--accent-ink, #f4f1ea);
  }

  .sim-feedback[data-state='err'] {
    border-color: var(--danger, #b42318);
    background: var(--danger-surface, rgba(180, 35, 24, 0.08));
    color: var(--danger, #b42318);
  }

  @media (prefers-reduced-motion: reduce) {
    .sim-key {
      transition: none;
    }
  }
</style>
