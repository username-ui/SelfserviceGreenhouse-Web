---
import AppLayout from '../layouts/AppLayout.astro';

if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<AppLayout title="登录 - 智农温室云控" showNav={false}>
  <section class="auth-shell">
    <div class="wrap">
      <div class="auth-single" data-enter>
        <div class="auth-brand-row auth-brand-row--center">
          <span class="brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter">
              <path d="M4 20C4 11 10 4 20 4c0 10-7 16-16 16Z" />
              <path d="M4 20L14 10" />
            </svg>
          </span>
          <div>
            <div class="brand-title">智农温室云控</div>
          </div>
        </div>

        <div class="auth-panel">
          <h1 class="auth-panel-title">登录</h1>

          <div id="login-error" class="alert alert-danger" role="alert" style="display: none; margin-bottom: 16px;">
          <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span id="login-error-text"></span>
        </div>

        <form id="login-form" novalidate>
          <div class="form-group">
            <label class="form-label" for="login-username">用户名</label>
            <input
              id="login-username"
              name="username"
              type="text"
              class="form-input mono"
              placeholder="请输入用户名"
              autocomplete="username"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="login-password">密码</label>
            <input
              id="login-password"
              name="password"
              type="password"
              class="form-input"
              placeholder="请输入登录密码"
              autocomplete="current-password"
              required
            />
          </div>

          <button type="submit" id="login-submit-btn" class="btn btn-primary btn-lg btn-block">
            登录工作台
          </button>
        </form>

          <div class="auth-footer-link">
            <span>还没有温室管理账号？</span>
            <a href="/register" style="font-weight: 500; text-decoration: underline; text-underline-offset: 4px;">
              注册新账号 →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('login-form');
      const usernameInput = document.getElementById('login-username');
      const passwordInput = document.getElementById('login-password');
      const submitBtn = document.getElementById('login-submit-btn');
      const errorBox = document.getElementById('login-error');
      const errorText = document.getElementById('login-error-text');

      if (!form || !usernameInput || !passwordInput || !submitBtn || !errorBox || !errorText) return;

      function setError(msg) {
        if (!msg) {
          errorBox.style.display = 'none';
          errorText.textContent = '';
          return;
        }
        errorText.textContent = msg;
        errorBox.style.display = 'flex';
      }

      function setLoading(loading) {
        if (loading) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.textContent = '正在验证登录...';
        } else {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = '登录工作台';
        }
      }

      async function performLogin(username, password) {
        setError('');
        if (!username || !password) {
          setError('请输入用户名和密码');
          return;
        }

        setLoading(true);
        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });

          let payload = null;
          try {
            payload = await res.json();
          } catch {
            payload = null;
          }

          if (res.ok && payload?.ok) {
            if (typeof window.showToastNextLoad === 'function') {
              const displayName = payload?.data?.user?.displayName || username;
              window.showToastNextLoad(`欢迎回来，${displayName}`, 'success');
            }
            window.location.assign('/');
            return;
          }

          setError(payload?.message || '用户名或密码错误，请重新核对');
        } catch {
          setError('网络请求失败，请确认服务已启动');
        } finally {
          setLoading(false);
        }
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        performLogin(usernameInput.value.trim(), passwordInput.value);
      });
    })();
  </script>
</AppLayout>
