---
import AppLayout from '../layouts/AppLayout.astro';

if (Astro.locals.user) {
  return Astro.redirect('/');
}
---

<AppLayout title="注册账号 - 智农温室云控" showNav={false}>
  <section class="auth-shell">
    <div class="wrap auth-grid">
      <div class="auth-brief" data-enter>
        <div class="auth-brand-row">
          <span class="brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter">
              <path d="M4 20C4 11 10 4 20 4c0 10-7 16-16 16Z" />
              <path d="M4 20L14 10" />
            </svg>
          </span>
          <div>
            <div class="brand-title">智农温室云控</div>
            <div class="brand-sub">智慧农业温室控制终端</div>
          </div>
        </div>

        <div>
          <div class="eyebrow">新账号注册</div>
          <h1 class="auth-headline">开通智能温室管理账号</h1>
          <p class="auth-desc">
            注册后即可在工作台添加名下的温室控制器编号，随时查看大棚实时环境并调节作物生长参数。
          </p>
        </div>

        <div class="topology-frame">
          <div class="topology-head">
            <span>温室智能闭环管理流程</span>
            <span>全天候自动运行</span>
          </div>
          <svg
            viewBox="0 0 640 164"
            width="100%"
            role="img"
            aria-label="智能温室闭环管理流程：01 环境感知 到 02 智能调控 到 03 自动灌溉 到 04 异常预警"
          >
            <line x1="142" y1="68" x2="176" y2="68" stroke="#1c201b" stroke-width="1.5" />
            <polyline points="170,63 176,68 170,73" fill="none" stroke="#1c201b" stroke-width="1.5" />

            <line x1="310" y1="68" x2="344" y2="68" stroke="#1c201b" stroke-width="1.5" />
            <polyline points="338,63 344,68 338,73" fill="none" stroke="#1c201b" stroke-width="1.5" />

            <line x1="478" y1="68" x2="504" y2="68" stroke="#23533b" stroke-width="1.75" />
            <polyline points="498,63 504,68 498,73" fill="none" stroke="#23533b" stroke-width="1.75" />

            <rect x="8" y="28" width="134" height="80" rx="4" fill="#f4f1ea" stroke="#1c201b" stroke-width="1.4" />
            <text x="20" y="52" fill="#5a5e56" font-family="JetBrains Mono, monospace" font-size="11">01 · 感知</text>
            <text x="20" y="74" fill="#1c201b" font-family="Noto Sans SC, sans-serif" font-size="14" font-weight="500">环境感知</text>
            <text x="20" y="95" fill="#5a5e56" font-family="Noto Sans SC, sans-serif" font-size="11">温湿度 · 光照</text>

            <rect x="176" y="28" width="134" height="80" rx="4" fill="#f4f1ea" stroke="#1c201b" stroke-width="1.4" />
            <text x="188" y="52" fill="#5a5e56" font-family="JetBrains Mono, monospace" font-size="11">02 · 调控</text>
            <text x="188" y="74" fill="#1c201b" font-family="Noto Sans SC, sans-serif" font-size="14" font-weight="500">智能调控</text>
            <text x="188" y="95" fill="#5a5e56" font-family="Noto Sans SC, sans-serif" font-size="11">风扇 · 补光 · 加热</text>

            <rect x="344" y="28" width="134" height="80" rx="4" fill="#f4f1ea" stroke="#1c201b" stroke-width="1.4" />
            <text x="356" y="52" fill="#5a5e56" font-family="JetBrains Mono, monospace" font-size="11">03 · 灌溉</text>
            <text x="356" y="74" fill="#1c201b" font-family="Noto Sans SC, sans-serif" font-size="14" font-weight="500">自动灌溉</text>
            <text x="356" y="95" fill="#5a5e56" font-family="Noto Sans SC, sans-serif" font-size="11">墒情 · 水位管理</text>

            <rect x="504" y="22" width="128" height="92" rx="4" fill="#e7e0d3" stroke="#23533b" stroke-width="2" stroke-dasharray="4 3" />
            <text x="516" y="48" fill="#23533b" font-family="JetBrains Mono, monospace" font-size="11" font-weight="500">04 · 保障</text>
            <text x="516" y="71" fill="#1c201b" font-family="Noto Sans SC, sans-serif" font-size="14" font-weight="500">异常预警</text>
            <text x="516" y="93" fill="#5a5e56" font-family="Noto Sans SC, sans-serif" font-size="11">缺水 · 设备告警</text>

            <line x1="8" y1="136" x2="632" y2="136" stroke="rgba(28,32,27,0.18)" stroke-width="1" />
            <text x="8" y="153" fill="#5a5e56" font-family="Noto Sans SC, sans-serif" font-size="11">
              实时环境监测  ·  目标阈值调节  ·  自动化联动启停  ·  及时预警提醒
            </text>
          </svg>
        </div>

        <ul class="rows" aria-label="核心管理能力">
          <li>
            <span class="rows__name">环境监测</span>
            <span class="rows__value">温湿度、土壤墒情与光照持续采集</span>
          </li>
          <li>
            <span class="rows__name">联动控制</span>
            <span class="rows__value">按设定区间自动调节风扇、补光与加热</span>
          </li>
          <li>
            <span class="rows__name">安全告警</span>
            <span class="rows__value">水箱缺水与执行异常实时预警通知</span>
          </li>
        </ul>
      </div>

      <div class="auth-panel" data-enter>
        <h2 class="auth-panel-title">注册新账号</h2>
        <p class="auth-panel-sub">填写账号信息以开启智能温室管理工作台</p>

        <div id="register-error" class="alert alert-danger" role="alert" style="display: none; margin-bottom: 16px;">
          <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <span id="register-error-text"></span>
        </div>

        <form id="register-form" novalidate>
          <div class="form-group">
            <label class="form-label" for="reg-username">
              <span>用户名 <span class="required-mark">*</span></span>
              <span class="form-hint mono">3~24 位字母/数字/下划线</span>
            </label>
            <input
              id="reg-username"
              name="username"
              type="text"
              class="form-input mono"
              placeholder="例如：wang_farm"
              autocomplete="username"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="reg-display-name">
              <span>显示名称</span>
              <span class="form-hint">选填，默认使用用户名</span>
            </label>
            <input
              id="reg-display-name"
              name="displayName"
              type="text"
              class="form-input"
              placeholder="例如：王农艺师 · 草莓实验区"
              maxlength="40"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="reg-password">
              <span>登录密码 <span class="required-mark">*</span></span>
              <span class="form-hint">至少 6 位字符</span>
            </label>
            <input
              id="reg-password"
              name="password"
              type="password"
              class="form-input"
              placeholder="请设置不少于 6 位的密码"
              autocomplete="new-password"
              minlength="6"
              required
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="reg-confirm-password">
              <span>确认密码 <span class="required-mark">*</span></span>
            </label>
            <input
              id="reg-confirm-password"
              name="confirmPassword"
              type="password"
              class="form-input"
              placeholder="请再次输入密码"
              autocomplete="new-password"
              required
            />
          </div>

          <button type="submit" id="register-submit-btn" class="btn btn-primary btn-lg btn-block">
            注册并进入工作台
          </button>
        </form>

        <div class="auth-footer-link">
          <span>已有系统账号？</span>
          <a href="/login" style="font-weight: 500; text-decoration: underline; text-underline-offset: 4px;">
            返回登录页面 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('register-form');
      const usernameInput = document.getElementById('reg-username');
      const displayNameInput = document.getElementById('reg-display-name');
      const passwordInput = document.getElementById('reg-password');
      const confirmInput = document.getElementById('reg-confirm-password');
      const submitBtn = document.getElementById('register-submit-btn');
      const errorBox = document.getElementById('register-error');
      const errorText = document.getElementById('register-error-text');

      if (!form || !usernameInput || !passwordInput || !confirmInput || !submitBtn || !errorBox || !errorText) return;

      function setError(msg) {
        if (!msg) {
          errorBox.style.display = 'none';
          errorText.textContent = '';
          return;
        }
        errorText.textContent = msg;
        errorBox.style.display = 'flex';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        setError('');

        const username = usernameInput.value.trim();
        const displayName = displayNameInput ? displayNameInput.value.trim() : '';
        const password = passwordInput.value;
        const confirmPassword = confirmInput.value;

        if (!/^[a-zA-Z0-9_]{3,24}$/.test(username)) {
          setError('用户名格式不正确：须为 3~24 位字母、数字或下划线');
          usernameInput.focus();
          return;
        }

        if (password.length < 6) {
          setError('密码长度不能少于 6 位字符');
          passwordInput.focus();
          return;
        }

        if (password !== confirmPassword) {
          setError('两次输入的密码不一致，请重新确认');
          confirmInput.focus();
          return;
        }

        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = '正在创建账号...';

        try {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              username,
              password,
              displayName: displayName || undefined,
            }),
          });

          let payload = null;
          try {
            payload = await res.json();
          } catch {
            payload = null;
          }

          if (res.status === 201 || (res.ok && payload?.ok)) {
            if (typeof window.showToastNextLoad === 'function') {
              window.showToastNextLoad('注册成功！欢迎使用智农温室云控', 'success');
            }
            window.location.assign('/');
            return;
          }

          setError(payload?.message || `注册失败 (${res.status})，请检查输入信息`);
        } catch {
          setError('网络请求失败，请确认服务已启动');
        } finally {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = '注册并进入工作台';
        }
      });
    })();
  </script>
</AppLayout>
