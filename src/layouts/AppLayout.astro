---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import type { BackendHealth, PublicUser } from '../types/greenhouse';

export interface Props {
  title?: string;
  user?: PublicUser | null;
  showNav?: boolean;
  health?: BackendHealth | null;
}

const {
  title = '智农温室云控',
  user = Astro.locals.user ?? null,
  showNav = true,
  health = null,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-type="software" data-radius="sharp" data-buttons="solid" data-motion>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#f4f1ea" />
    <meta name="description" content="智农温室云控 - 设施农业环境监测与智能控制平台" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    {showNav ? (
      <Navbar user={user} health={health} />
    ) : (
      <a class="skip-link" href="#top" style="top: 24px;">跳至正文</a>
    )}

    <main id="top" class={showNav ? 'page-main' : 'page-main page-main--bare'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">智农温室云控</div>
            <p class="footer-note">
              设施农业环境监测与智能控制平台，支持温室大棚温湿度、光照实时采集，联动调节风扇、补光、加热及智能灌溉。
            </p>
          </div>

          <div class="footer-spec-list">
            <span>环境监测 · 温湿光实时采集</span>
            <span>联动控制 · 通风补光加热自动调节</span>
            <span>智能灌溉 · 土壤墒情与水位预警</span>
          </div>

          <nav class="footer-links" aria-label="页脚导航">
            {user ? (
              <a href="/">我的工作台</a>
            ) : (
              <>
                <a href="/login">账号登录</a>
                <a href="/register">注册账号</a>
              </>
            )}
          </nav>
        </div>

        <div class="footer-bottom">
          <span>智农温室云控平台</span>
          <span>智慧设施农业管理系统</span>
        </div>
      </div>
    </footer>

    <div id="gh-toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <script is:inline>
      (() => {
        const TOAST_STORAGE_KEY = 'gh_pending_toast';
        const container = document.getElementById('gh-toast-container');

        function renderToast(message, type = 'info', duration = 3600) {
          if (!container || !message) return;
          const validType = ['success', 'error', 'warning', 'info'].includes(type) ? type : 'info';

          const toast = document.createElement('div');
          toast.className = `toast toast-${validType}`;
          toast.setAttribute('role', 'status');

          const body = document.createElement('div');
          body.style.flex = '1';
          body.textContent = String(message);

          const closeBtn = document.createElement('button');
          closeBtn.type = 'button';
          closeBtn.className = 'toast-close';
          closeBtn.setAttribute('aria-label', '关闭提示');
          closeBtn.textContent = '×';

          let timer = null;
          const dismiss = () => {
            if (timer) clearTimeout(timer);
            toast.remove();
          };

          closeBtn.addEventListener('click', dismiss);
          toast.appendChild(body);
          toast.appendChild(closeBtn);
          container.appendChild(toast);

          if (duration > 0) {
            timer = setTimeout(dismiss, duration);
          }
        }

        window.showToast = renderToast;

        window.showToastNextLoad = (message, type = 'success') => {
          try {
            sessionStorage.setItem(
              TOAST_STORAGE_KEY,
              JSON.stringify({ message: String(message), type })
            );
          } catch {
            // ignore storage quota/privacy mode errors
          }
        };

        window.addEventListener('gh:toast', (event) => {
          const detail = event?.detail || {};
          if (detail.message) {
            renderToast(detail.message, detail.type || 'info', detail.duration || 3600);
          }
        });

        try {
          const raw = sessionStorage.getItem(TOAST_STORAGE_KEY);
          if (raw) {
            sessionStorage.removeItem(TOAST_STORAGE_KEY);
            const parsed = JSON.parse(raw);
            if (parsed && parsed.message) {
              renderToast(parsed.message, parsed.type || 'success');
            }
          }
        } catch {
          // ignore invalid session toast payload
        }
      })();
    </script>
  </body>
</html>
